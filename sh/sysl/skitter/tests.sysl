// What can be checked without a phone, which is exactly the part that can be wrong without
// anything crashing.
//
// **The bridge's binding is not testable here and is not pretended to be.** Whether JNI finds
// `Java_sh_sysl_skitter_SkitterActivity_nativeSetSystemBars` is decided by a class name in an APK on
// a device; a test that mocked the lookup would be asserting the mock. What is tested is the half a
// mock cannot help with — the arithmetic that turns bars into a rectangle, and the storage the
// bridge writes — because a sign error there is an interface drawn off the bottom of every phone
// with a navigation bar, and it looks like a layout bug rather than like this.

module sh.sysl.skitter
@tests

import sh.sysl.sdl3.{WINDOW_RESIZABLE, WINDOW_HIGH_PIXEL_DENSITY, ANDROID_COMMAND_USER}
import sh.sysl.sdl3.{set_hint, init, quit, screen_saver_enabled, HINT_VIDEO_DRIVER, INIT_VIDEO}

// ## The rectangle the bars leave

@test
private a_window_with_no_bars_is_all_usable()
    val r = fit(1080, 2400, Insets(0, 0, 0, 0))

    assert_eq(r.x, 0.0f32)
    assert_eq(r.y, 0.0f32)
    assert_eq(r.w, 1080.0f32)
    assert_eq(r.h, 2400.0f32)
end a_window_with_no_bars_is_all_usable

// The ordinary phone: a status bar at the top and a navigation bar at the bottom, and nothing at
// the sides. These are the numbers a 1080x2400 emulator actually reports.
@test
private the_bars_come_off_the_edges_they_are_on()
    val r = fit(1080, 2400, Insets(0, 63, 0, 63))

    assert_eq(r.x, 0.0f32, "nothing is taken off the left")
    assert_eq(r.y, 63.0f32, "the drawing starts below the status bar")
    assert_eq(r.w, 1080.0f32, "the full width is still there")
    assert_eq(r.h, 2274.0f32, "and both bars come out of the height")
end the_bars_come_off_the_edges_they_are_on

// A cutout or a turned phone puts bars on the sides too, and each one comes off its own edge rather
// than off both.
@test
private a_side_bar_moves_the_origin_and_shrinks_the_width_once()
    val r = fit(2400, 1080, Insets(80, 0, 40, 63))

    assert_eq(r.x, 80.0f32)
    assert_eq(r.w, 2280.0f32, "2400 less the 80 on the left and the 40 on the right")
    assert_eq(r.h, 1017.0f32)
end a_side_bar_moves_the_origin_and_shrinks_the_width_once

// **The case this clamping exists for.** Some devices report the new bars before SDL reports the new
// window, so for a frame or two after a rotation the insets are the ones measured against the *other*
// orientation and are larger than the size they are being applied to. An unclamped subtraction gives
// a negative width, and the renderer does not clip a negative `FRect` — it draws it inside out.
@test
private bars_larger_than_the_window_leave_nothing_rather_than_less_than_nothing()
    val r = fit(400, 200, Insets(300, 500, 300, 500))

    assert_eq(r.w, 0.0f32, "no negative width")
    assert_eq(r.h, 0.0f32, "no negative height")
    assert(r.x <= 400.0f32 && r.y <= 200.0f32, "and the origin stays inside the window")
end bars_larger_than_the_window_leave_nothing_rather_than_less_than_nothing

// Bars that exactly meet leave an empty rectangle, not a negative one — the boundary either side of
// the clamp above.
@test
private bars_that_exactly_meet_leave_nothing()
    val r = fit(100, 128, Insets(40, 64, 60, 64))

    assert_eq(r.w, 0.0f32)
    assert_eq(r.h, 0.0f32)

// ## What the bridge stores
//
// **This drives the exported function itself**, which is the only part of the bridge that is sysl
// rather than a name in an APK: JNI hands it six arguments, the first two of which every native
// method gets and neither of which is read.
@test
private the_bridge_stores_what_android_reports()
    set_system_bars(null, null, 10, 20, 30, 40)

    assert_eq(insets(), Insets(10, 20, 30, 40))

    // Reported again on the next rotation, and the second report replaces the first rather than
    // accumulating onto it.
    set_system_bars(null, null, 1, 2, 3, 4)

    assert_eq(insets(), Insets(1, 2, 3, 4))

    // Left as it was found, since these are module storage and the tests above read `fit` only.
    set_system_bars(null, null, 0, 0, 0, 0)
end the_bridge_stores_what_android_reports

// ## Insets themselves

@test
private insets_compare_on_all_four_edges()
    assert(Insets(1, 2, 3, 4) == Insets(1, 2, 3, 4))
    assert(Insets(1, 2, 3, 4) != Insets(1, 2, 3, 5), "the bottom is not ignored")
    assert(Insets(1, 2, 3, 4) != Insets(9, 2, 3, 4), "and neither is the left")
end insets_compare_on_all_four_edges

@test
private insets_print_as_named_edges() =
    assert_eq(s"${Insets(0, 63, 0, 63)}", "left=0 top=63 right=0 bottom=63")

// ## The orientation flags

// **The pair that is silent when wrong.** `window_flags` exists so that `WINDOW_RESIZABLE` cannot be
// left off, and folding in a program's own flags must not drop it.
@test
private the_window_is_resizable_whatever_else_is_asked_for()
    assert(window_flags() & WINDOW_RESIZABLE != 0)
    assert(window_flags(WINDOW_HIGH_PIXEL_DENSITY) & WINDOW_RESIZABLE != 0)
    assert(window_flags(WINDOW_HIGH_PIXEL_DENSITY) & WINDOW_HIGH_PIXEL_DENSITY != 0,
           "and what was asked for is still there")
end the_window_is_resizable_whatever_else_is_asked_for

// ## The phone

// **The short names are `skitter.permissions`' table**, row for row — `app/build.gradle.kts` in
// `skitter-app` — so a program asks with the word its `gradle.properties` used. A swapped row here
// would ask for the camera when the program said the microphone, and nothing else would notice.
@test
private the_short_names_are_the_ones_gradle_properties_uses()
    assert_eq(android_permission("microphone"), Some("android.permission.RECORD_AUDIO"))
    assert_eq(android_permission("camera"), Some("android.permission.CAMERA"))
    assert_eq(android_permission("internet"), Some("android.permission.INTERNET"))
    assert_eq(android_permission("bluetooth"), Some("android.permission.BLUETOOTH_CONNECT"),
              "the one that is asked for at run time")
    assert_eq(android_permission("vibrate"), Some("android.permission.VIBRATE"))
end the_short_names_are_the_ones_gradle_properties_uses

@test
private androids_own_spelling_passes_through_and_nothing_else_does()
    assert_eq(android_permission("android.permission.WAKE_LOCK"), Some("android.permission.WAKE_LOCK"))
    assert_eq(android_permission("microphon"), None, "a misspelling stands for nothing")
    assert_eq(android_permission("Microphone"), None, "and the names are lower case")
    assert_eq(android_permission(""), None)

// **The numbers are `SkitterActivity`'s**, which matches on them, and SDL keeps everything below
// `0x8000` for itself — a command there would reach SDL's handler instead of ours.
@test
private the_commands_are_the_activitys_numbers()
    assert_eq(COMMAND_VIBRATE, 0x8001u32)
    assert_eq(COMMAND_TICK, 0x8002u32)
    assert_eq(COMMAND_SHARE, 0x8003u32)
    assert_eq(COMMAND_CHECK_PERMISSION, 0x8004u32)
    assert(COMMAND_VIBRATE >= ANDROID_COMMAND_USER, "above SDL's own")

    assert_eq(HINT_SHARE_TEXT, "SKITTER_SHARE_TEXT")
    assert_eq(HINT_PERMISSION, "SKITTER_PERMISSION")
end the_commands_are_the_activitys_numbers

// The activity answers `question * 2 + granted`, and an answer to an earlier question must not be
// read as the answer to this one — that is the late reply arriving after the wait gave up.
@test
private an_answer_is_read_only_for_its_own_question()
    assert_eq(answer_to(7, permission_answer(7, true)), Some(true))
    assert_eq(answer_to(7, permission_answer(7, false)), Some(false))
    assert_eq(answer_to(8, permission_answer(7, true)), None, "a late answer to the last question")
    assert_eq(answer_to(1, 0), None, "nothing has been answered yet")
end an_answer_is_read_only_for_its_own_question

// **This drives the exported function**, as `the_bridge_stores_what_android_reports` does for the
// bars: what the activity calls is what `permission_granted` reads.
@test
private the_answer_lands_where_it_is_read()
    permission_answered(null, null, i32(permission_answer(3, true)))

    assert_eq(answer_to(3, permission_reply), Some(true))

    permission_answered(null, null, 0)

private struct Answered
    times: int
    granted: bool

// ## On a desktop
//
// **What a program running in both places gets here**, and every one of these is a promise the
// module's header makes: the buzz and the share answer `false`, every permission Android would
// recognise is granted, and asking for one answers at once.
//
// The `os()` tests are because a phone answers these differently; an `#if` is kept out of the
// package for the reason `phone.sysl` gives.
@test
private a_desktop_has_nothing_to_buzz_or_share()
    if os() != Os.Android
        assert(!vibrate(40), "no vibrator")
        assert(!tick(), "nor a tick")
        assert(!share_text("hello"), "and no share sheet")

    assert(!vibrate(0), "a buzz of no length is never sent, anywhere")
    assert(!vibrate(-5))
end a_desktop_has_nothing_to_buzz_or_share

@test
private a_desktop_grants_every_permission_android_would_know()
    if os() != Os.Android
        assert(permission_granted("microphone"))
        assert(permission_granted("android.permission.WAKE_LOCK"))

    assert(!permission_granted("microphon"), "but a name that stands for nothing is not, anywhere")

@test
private a_desktop_answers_a_request_at_once()
    if os() != Os.Android
        var got: &sync Answered = Answered(0, false)

        val asked = request_permission("camera", (yes) ->
            got.times += 1
            got.granted = yes)

        assert(asked, "the request was made")
        assert_eq(got.times, 1, "answered before the call returned")
        assert(got.granted)

    var none: &sync Answered = Answered(0, false)

    assert(!request_permission("camra", (yes) -> none.times += 1), "a misspelling asks nobody")
    assert_eq(none.times, 0, "and is never answered")
end a_desktop_answers_a_request_at_once

// The screen is SDL's on a desktop as well, read back through SDL's own switch.
@test
private keeping_awake_is_sdls_screensaver_switch()
    set_hint(HINT_VIDEO_DRIVER, "dummy")
    assert(init(INIT_VIDEO), "SDL_Init")

    keep_awake(false)
    assert(screen_saver_enabled(), "the display may sleep")

    keep_awake(true)
    assert(!screen_saver_enabled(), "and it is kept on")

    quit()
end keeping_awake_is_sdls_screensaver_switch
