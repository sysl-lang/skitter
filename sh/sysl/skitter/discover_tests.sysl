// Discovery's table, its commands, and the JNI reading — the last against a JNI environment made
// here, so the table positions and the calls through them are exercised without a phone.
//
// **The table is one per process and the tests may run side by side**, so everything that writes it
// is one test, in sequence, rather than several that could interleave.

module sh.sysl.skitter
@tests

import sysl.raw.ptr_cast
import sysl.slices.as_ptr

// ## A JNI environment, as far as two of its functions
//
// A Java `byte[]` is stood for by the address of one of these; the two functions below are what
// `GetArrayLength` and `GetByteArrayRegion` do with a real one.
private struct FakeArray
    len: i32
    at: *u8

private fake_length(env: *u8, array: *u8) -> i32
    val a: *FakeArray = ptr_cast(array)

    a.len

private fake_region(env: *u8, array: *u8, start: i32, n: i32, out: *u8)
    val a: *FakeArray = ptr_cast(array)

    for i in 0..<usize(n)
        val from: *u8 = ptr_cast(usize(a.at) + usize(start) + i)
        val to: *u8 = ptr_cast(usize(out) + i)

        *to = *from

// A table with every entry zero but the two this side calls, and an `env` pointing at it — so a
// position off by one calls address zero and the test dies rather than passing.
private struct FakeEnv
    table: [256]usize
    functions: usize

private fake_env() -> &FakeEnv
    val e: &FakeEnv = FakeEnv([0; 256], 0)
    val length: *u8 = ptr_cast(&fake_length)
    val region: *u8 = ptr_cast(&fake_region)

    // The specification's positions written out, not the constants under test — a fake built from
    // those would move with them and could never catch one that was wrong.
    e.table[171] = usize(length)
    e.table[200] = usize(region)
    e.functions = usize(&e.table[0])
    e

private env_of(e: &FakeEnv) -> *u8 = ptr_cast(&e.functions)

private text_through(e: &FakeEnv, bytes: []const u8) -> string
    val a: &FakeArray = FakeArray(i32(bytes.len), ptr_cast(as_ptr(bytes)))

    jni_text(env_of(e), ptr_cast(&*a))

@test
private the_table_positions_are_the_jni_specifications()
    assert_eq(JNI_GET_ARRAY_LENGTH, 171)
    assert_eq(JNI_GET_BYTE_ARRAY_REGION, 200)

@test
private a_byte_array_reads_back_as_its_utf8()
    val e = fake_env()

    assert_eq(text_through(e, "ed-mbp".bytes), "ed-mbp")
    assert_eq(text_through(e, "Ed’s MacBook 🍎".bytes), "Ed’s MacBook 🍎")

// A character outside the Basic Multilingual Plane survives whole — the reason the activity sends
// bytes rather than a `jstring`.
@test
private a_four_byte_character_is_one_character()
    val e = fake_env()
    val s = text_through(e, "🍎".bytes)

    assert_eq(s.len, 4)
    assert_eq(s, "\u{1F34E}")

@test
private bytes_that_are_not_utf8_are_replaced()
    val e = fake_env()
    val bad: [3]u8 = [u8('a'), 0xFF, u8('b')]

    assert_eq(text_through(e, bad), "a\u{FFFD}b")

@test
private a_null_or_empty_array_is_the_empty_string()
    val e = fake_env()
    val nothing: [1]u8 = [0]
    val empty: &FakeArray = FakeArray(0, ptr_cast(as_ptr(nothing)))

    assert_eq(jni_text(env_of(e), null), "")
    assert_eq(jni_text(env_of(e), ptr_cast(&*empty)), "")

@test
private the_commands_follow_phones_and_the_activity_matches_them()
    assert_eq(COMMAND_DISCOVER, 0x8005)
    assert_eq(COMMAND_STOP_DISCOVERY, 0x8006)
    assert(COMMAND_DISCOVER > COMMAND_CHECK_PERMISSION)
    assert_eq(HINT_DISCOVER_TYPE, "SKITTER_DISCOVER_TYPE")

@test
private the_table_follows_what_the_activity_reports()
    // A desktop has nothing to browse with, but starting still empties the table.
    service_found(Service("stale", "10.0.0.1", 1))
    assert(!discover("_marshal._tcp"))
    assert_eq(services().len(), 0)
    assert(!stop_discovery())

    var seen = discovery_generation()

    service_found(Service("ed-mbp", "192.168.1.20", 7177))
    assert(discovery_generation() != seen)
    seen = discovery_generation()

    service_found(Service("studio", "192.168.1.30", 7177))

    var now = services()

    assert_eq(now.len(), 2)
    assert_eq(now[0], Service("ed-mbp", "192.168.1.20", 7177))
    assert_eq(now[1].name, "studio")

    // Seen again under the same name: the entry is replaced in place, not added twice.
    service_found(Service("ed-mbp", "192.168.1.21", 7178))
    now = services()
    assert_eq(now.len(), 2)
    assert_eq(now[0], Service("ed-mbp", "192.168.1.21", 7178))

    // A copy: the table moving on does not change what was read.
    service_lost("ed-mbp")
    assert_eq(now.len(), 2)
    now = services()
    assert_eq(now.len(), 1)
    assert_eq(now[0].name, "studio")

    // Losing what is not there changes nothing but the generation.
    service_lost("nobody")
    assert_eq(services().len(), 1)

    // The exports, through a JNI environment, land in the same table.
    val e = fake_env()
    val name = "Ed’s 🍎"
    val host = "192.168.1.40"
    val n: &FakeArray = FakeArray(i32(name.len), ptr_cast(as_ptr(name.bytes)))
    val h: &FakeArray = FakeArray(i32(host.len), ptr_cast(as_ptr(host.bytes)))

    service_found_jni(env_of(e), null, ptr_cast(&*n), ptr_cast(&*h), 7177)
    now = services()
    assert_eq(now.len(), 2)
    assert_eq(now[1], Service("Ed’s 🍎", "192.168.1.40", 7177))

    service_lost_jni(env_of(e), null, ptr_cast(&*n))
    assert_eq(services().len(), 1)

    assert_eq(discovery_failure(), 0)
    discovery_failed_jni(env_of(e), null, 3)
    assert_eq(discovery_failure(), 3)

    // Starting again forgets the failure with the services.
    discover("_marshal._tcp")
    assert_eq(discovery_failure(), 0)
    assert_eq(services().len(), 0)
end the_table_follows_what_the_activity_reports
